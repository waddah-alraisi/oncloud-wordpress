{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#0F334D" },
        { "slug": "secondary", "name": "Secondary", "color": "#1A4D70" },
        { "slug": "accent", "name": "Accent", "color": "#E8643B" },
        { "slug": "surface", "name": "Surface", "color": "#F4F6F8" },
        { "slug": "background", "name": "Background", "color": "#FFFFFF" },
        { "slug": "text", "name": "Text", "color": "#14212B" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Inter and IBM Plex Sans Arabic",
          "fontFamily": "Inter, \"IBM Plex Sans Arabic\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-variable.woff2"] },
            { "fontFamily": "IBM Plex Sans Arabic", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/plex-arabic-400.woff2"] },
            { "fontFamily": "IBM Plex Sans Arabic", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/plex-arabic-700.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Extra large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.75rem" } }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--text)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "spacing": { "padding": { "left": "1rem", "right": "1rem" }, "blockGap": "1.5rem" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--secondary)" } },
      "heading": { "color": { "text": "var(--wp--preset--color--primary)" }, "typography": { "fontWeight": "700", "lineHeight": "1.2" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--background)" },
        "border": { "radius": "8px" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
