{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "custom": false,
            "palette": [
                {
                    "slug": "primary",
                    "name": "Primary",
                    "color": "#0F334D"
                },
                {
                    "slug": "secondary",
                    "name": "Secondary",
                    "color": "#1A4D70"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#E8643B"
                },
                {
                    "slug": "surface",
                    "name": "Surface",
                    "color": "#F4F6F8"
                },
                {
                    "slug": "background",
                    "name": "Background",
                    "color": "#FFFFFF"
                },
                {
                    "slug": "text",
                    "name": "Text",
                    "color": "#14212B"
                }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "body",
                    "name": "Inter and IBM Plex Sans Arabic",
                    "fontFamily": "Inter, \"IBM Plex Sans Arabic\", system-ui, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontWeight": "100 900",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/inter-variable.woff2"
                            ]
                        },
                        {
                            "fontFamily": "IBM Plex Sans Arabic",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/plex-arabic-400.woff2"
                            ]
                        },
                        {
                            "fontFamily": "IBM Plex Sans Arabic",
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/plex-arabic-700.woff2"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Small",
                    "size": "0.875rem"
                },
                {
                    "slug": "medium",
                    "name": "Medium",
                    "size": "1rem"
                },
                {
                    "slug": "large",
                    "name": "Large",
                    "size": "1.375rem",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.5rem"
                    }
                },
                {
                    "slug": "x-large",
                    "name": "Extra large",
                    "size": "2.25rem",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.75rem"
                    }
                }
            ]
        },
        "spacing": {
            "units": [
                "px",
                "rem",
                "%",
                "vw"
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--text)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "spacing": {
            "padding": {
                "left": "1rem",
                "right": "1rem"
            },
            "blockGap": "1.5rem"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                "typography": {
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--background)"
                },
                "border": {
                    "radius": "8px"
                }
            }
        },
        "css": ".oncloud-live{list-style:none;padding:0;display:grid;gap:var(--wp--preset--spacing--40,1.5rem);grid-template-columns:repeat(auto-fill,minmax(16rem,1fr))}.oncloud-live li{border:1px solid color-mix(in srgb,var(--wp--preset--color--text) 12%,transparent);border-radius:.75rem;padding:1.25rem}.oncloud-live h3{margin:0 0 .5rem}.oncloud-live img{width:100%;height:auto;border-radius:.5rem}.oncloud-live blockquote{margin:0}.oncloud-price,.oncloud-client{font-weight:600}"
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}
