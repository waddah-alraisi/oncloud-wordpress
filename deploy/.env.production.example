# AN ONCLOUD WORDPRESS SERVER'S SETTINGS (deploy/compose.production.yaml). Copy to deploy/.env on the server, fill in,
# `chmod 600`. Never commit the filled-in file, never paste it anywhere. Values for a site OnCloud provisions come
# from the registry (Lane B); this template is for setting up the shared network by hand.

# The images: a version tag (0.5.0) once releases are tagged, or a build (sha-xxxxxxxxxxxx) from CI.
ONCLOUD_IMAGE_TAG=0.6.0
# Let's Encrypt writes here about the certificates.
ACME_EMAIL=ops@oncloud.om

ONCLOUD_ENV=production
# site (OnCloud Site) and storefront share the network; private_store is its own server.
ONCLOUD_PLAN=storefront
# The shared network: 1, with its main domain. A Private Store: 0, with its address in WP_HOME.
ONCLOUD_NETWORK=1
DOMAIN_CURRENT_SITE=sites.oncloud.om
# Set to 1 once `bin/install.sh` has made the network, then `docker compose up -d` again.
ONCLOUD_NETWORK_READY=0
# A Private Store only:
# WP_HOME=https://shop.example.com

DB_HOST=db
DB_NAME=oncloud
DB_USER=oncloud
# Generate each with: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
WP_REDIS_HOST=cache

# Generate the eight with: for i in 1 2 3 4 5 6 7 8; do openssl rand -hex 32; done
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
