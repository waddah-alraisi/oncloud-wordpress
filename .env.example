# Copy to .env for local runs. Production values come from the registry at provisioning; never commit them.
ONCLOUD_ENV=local
ONCLOUD_PLAN=storefront
ONCLOUD_NETWORK=0
WP_HOME=http://localhost:8080
DB_HOST=db
DB_NAME=oncloud
DB_USER=oncloud
DB_PASSWORD=oncloud
WP_REDIS_HOST=cache
# Generate the eight with: php -r 'for($i=0;$i<8;$i++) echo bin2hex(random_bytes(32)),"\n";'
AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me
