{
    "name": "oncloud/oncloud-wordpress",
    "description": "The OnCloud WordPress distribution: unmodified WordPress core and WooCommerce at pinned versions, the OnCloud must-use plugins, the allowed plugins and the OnCloud parent theme. Every OnCloud site is built from this repository (ADR 0052).",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": ["wpackagist-plugin/*", "wpackagist-theme/*"]
        },
        {
            "type": "vcs",
            "url": "https://github.com/waddah-alraisi/oncloud-wordpress-plugin"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "2.3.0",
        "oncloud/oncloud-wordpress-plugin": "dev-main#388f48e4fab58f28043dda285184f26d99c5744d",
        "roots/wordpress-core-installer": "4.0.0",
        "roots/wordpress-no-content": "7.1.3",
        "wp-cli/wp-cli-bundle": "2.12.0",
        "wpackagist-plugin/polylang": "3.9.1",
        "wpackagist-plugin/woocommerce": "11.2.1"
    },
    "extra": {
        "wordpress-install-dir": "web/wp",
        "installer-paths": {
            "web/app/mu-plugins/oncloud/": ["oncloud/oncloud-wordpress-plugin"],
            "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
            "web/app/themes/{$name}/": ["type:wordpress-theme"]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "check": "php bin/check.php"
    }
}
